#!/usr/bin/env python3

import rclpy
from rclpy.node import Node
from rclpy.time import Time
from rclpy.qos import QoSProfile, ReliabilityPolicy, DurabilityPolicy

import numpy as np
import torch
import torch.nn as nn
import torch.nn.functional as F
from scipy.spatial.transform import Rotation as R
import time
from collections import deque
from gymnasium import spaces

from nav_msgs.msg import Odometry
from autoware_auto_planning_msgs.msg import Trajectory

# ======================================================================================
# SAC Components - Neural Networks
# ======================================================================================

class SACActorNetwork(nn.Module):
    def __init__(self, state_dim, action_dim, hidden_dim=256):
        super().__init__()
        self.feature_extractor = nn.Sequential(
            nn.Linear(state_dim, hidden_dim),
            nn.ReLU(),
            nn.Linear(hidden_dim, hidden_dim),
            nn.ReLU()
        )
        
        # 策略网络 - 输出均值和标准差
        self.mean_head = nn.Linear(hidden_dim, action_dim)
        self.log_std_head = nn.Linear(hidden_dim, action_dim)
        
    def forward(self, state):
        features = self.feature_extractor(state)
        mean = self.mean_head(features)
        log_std = self.log_std_head(features)
        log_std = torch.clamp(log_std, -20, 2)  # 限制标准差范围
        return mean, log_std

class SACCriticNetwork(nn.Module):
    def __init__(self, state_dim, action_dim, hidden_dim=256):
        super().__init__()
        self.q1 = nn.Sequential(
            nn.Linear(state_dim + action_dim, hidden_dim),
            nn.ReLU(),
            nn.Linear(hidden_dim, hidden_dim), 
            nn.ReLU(),
            nn.Linear(hidden_dim, 1)
        )
        
        self.q2 = nn.Sequential(
            nn.Linear(state_dim + action_dim, hidden_dim),
            nn.ReLU(), 
            nn.Linear(hidden_dim, hidden_dim),
            nn.ReLU(),
            nn.Linear(hidden_dim, 1)
        )
        
    def forward(self, state, action):
        sa = torch.cat([state, action], dim=-1)
        return self.q1(sa), self.q2(sa)

# ======================================================================================
# SAC Components - Managers and Logger
# ======================================================================================

class SACStateManager:
    def __init__(self):
        # 观测空间：(90, 13) - 90个时间步，每步13个特征
        self.observation_space = spaces.Box(
            low=-np.inf, high=np.inf, 
            shape=(90, 13), 
            dtype=np.float32
        )
        self.sequence_length = 90
        self.observation_buffer = deque(maxlen=self.sequence_length)
        
    def extract_state_features(self, features):
        """将13维特征向量添加到观测缓冲区并返回完整状态"""
        # 添加当前特征到缓冲区
        self.observation_buffer.append(features)
        
        # 如果缓冲区未满，用零填充
        while len(self.observation_buffer) < self.sequence_length:
            self.observation_buffer.append(np.zeros(13, dtype=np.float32))
        
        # 转换为numpy数组并展平
        state_sequence = np.array(list(self.observation_buffer))
        return state_sequence.flatten()  # shape: (90 * 13,)

class SACActionManager:
    def __init__(self):
        # 动作空间：连续的目标速度
        self.action_space = spaces.Box(
            low=0.0, high=10.0, 
            shape=(1,), 
            dtype=np.float32
        )
        
    def process_action(self, action):
        """处理SAC输出的动作，转换为目标速度"""
        target_velocity = float(action[0])
        # 添加物理约束检查
        target_velocity = np.clip(target_velocity, 0.0, 10.0)
        return target_velocity

class SACRewardCalculator:
    def __init__(self):
        # 调整后的奖励权重
        self.W_PROGRESS = 3.0      # 强化速度奖励权重 (从1.0增加到3.0)
        self.W_CENTER = 2.0        # 中线保持平衡一点 (从5.0降低到2.0)
        self.W_SMOOTHNESS = 0.1    # 速度平滑性权重
        self.W_EFFICIENCY = 1.0    # 新增：速度效率奖励
        self.MAX_DIST_FROM_CENTER = 3.0
        
        # 奖励统计
        self.reward_history = []
        self.component_rewards = {
            'progress': [],
            'lane_keeping': [],
            'smoothness': [],
            'efficiency': []
        }
        
    def calculate_reward(self, state_info, action, next_state_info=None):
        """计算奖励函数并记录详细统计"""
        current_velocity = state_info['velocity']
        distance_from_centerline = state_info['distance_from_centerline']
        target_velocity = action[0]
        
        # 1. 进度奖励：强化速度奖励，鼓励更快的前进
        reward_progress = self.W_PROGRESS * current_velocity
        if current_velocity > 5.0:  # 额外奖励高速行驶
            reward_progress += 0.5 * (current_velocity - 5.0)
        
        # 2. 中线保持奖励：平衡的惩罚，不过分严格
        reward_lane_keeping = -self.W_CENTER * (distance_from_centerline ** 2)
        
        # 3. 速度平滑性奖励：避免剧烈的速度变化
        if hasattr(self, 'last_target_velocity'):
            velocity_change = abs(target_velocity - self.last_target_velocity)
            reward_smoothness = -self.W_SMOOTHNESS * velocity_change
        else:
            reward_smoothness = 0.0
        self.last_target_velocity = target_velocity
        
        # 4. 新增：速度效率奖励（接近目标速度的奖励）
        if 'target_speed' in state_info:
            speed_error = abs(current_velocity - state_info['target_speed'])
            reward_efficiency = -self.W_EFFICIENCY * speed_error
        else:
            reward_efficiency = 0.0
        
        # 记录各组件奖励
        self.component_rewards['progress'].append(reward_progress)
        self.component_rewards['lane_keeping'].append(reward_lane_keeping)
        self.component_rewards['smoothness'].append(reward_smoothness)
        self.component_rewards['efficiency'].append(reward_efficiency)
        
        total_reward = reward_progress + reward_lane_keeping + reward_smoothness + reward_efficiency
        
        # 终止条件检查
        terminated = abs(distance_from_centerline) > self.MAX_DIST_FROM_CENTER
        if terminated:
            total_reward -= 200  # 严重惩罚
            
        self.reward_history.append(total_reward)
        
        return total_reward, terminated, {
            'reward_progress': reward_progress,
            'reward_lane_keeping': reward_lane_keeping,
            'reward_smoothness': reward_smoothness,
            'reward_efficiency': reward_efficiency,
            'total_reward': total_reward
        }

class SACLogger:
    def __init__(self, node_logger):
        self.logger = node_logger
        self.step_count = 0
        self.log_interval = 10  # 每10步详细日志一次
        self.summary_interval = 100  # 每100步统计日志一次
        
        # 统计数据
        self.metrics_history = {
            'actor_loss': [],
            'critic_loss': [],
            'q1_values': [],
            'q2_values': [],
            'actions': [],
            'rewards': [],
            'computation_time': []
        }
    
    def log_sac_initialization(self, components):
        """记录SAC组件初始化"""
        self.logger.info("=" * 80)
        self.logger.info("🚀 SAC COMPONENTS INITIALIZATION")
        self.logger.info("=" * 80)
        
        for name, component in components.items():
            if hasattr(component, 'parameters'):
                param_count = sum(p.numel() for p in component.parameters())
                self.logger.info(f"✅ {name.upper()}: {param_count:,} parameters")
            else:
                self.logger.info(f"✅ {name.upper()}: Initialized")
        
        self.logger.info("=" * 80)
    
    def log_step_details(self, step_data):
        """记录每步的详细信息"""
        self.step_count += 1
        
        if self.step_count % self.log_interval == 0:
            self.logger.info("─" * 60)
            self.logger.info(f"📊 SAC STEP {self.step_count} DETAILS")
            self.logger.info("─" * 60)
            
            # Actor信息
            self.logger.info(f"🎭 ACTOR:")
            self.logger.info(f"   Action Mean: {step_data['action_mean']:.4f}")
            self.logger.info(f"   Action Std:  {step_data['action_std']:.4f}")
            self.logger.info(f"   Final Action: {step_data['final_action']:.4f}")
            self.logger.info(f"   Action Range: [{step_data['action_min']:.4f}, {step_data['action_max']:.4f}]")
            
            # Critic信息
            self.logger.info(f"🏛️ CRITIC:")
            self.logger.info(f"   Q1 Value: {step_data['q1_value']:.4f}")
            self.logger.info(f"   Q2 Value: {step_data['q2_value']:.4f}")
            self.logger.info(f"   Target Q1: {step_data['target_q1']:.4f}")
            self.logger.info(f"   Target Q2: {step_data['target_q2']:.4f}")
            self.logger.info(f"   Min Q Value: {min(step_data['q1_value'], step_data['q2_value']):.4f}")
            
            # 奖励详情
            if 'reward_components' in step_data:
                self.logger.info(f"🎯 REWARD BREAKDOWN:")
                for comp, value in step_data['reward_components'].items():
                    self.logger.info(f"   {comp}: {value:.4f}")
            
            # 状态信息
            if 'state_info' in step_data:
                self.logger.info(f"🚗 VEHICLE STATE:")
                self.logger.info(f"   Velocity: {step_data['state_info']['velocity']:.3f} m/s")
                self.logger.info(f"   Distance from Center: {step_data['state_info']['distance_from_centerline']:.3f} m")
                self.logger.info(f"   Heading Error: {step_data['state_info'].get('heading_error', 0):.3f} rad")
            
            # 性能信息
            self.logger.info(f"⚡ PERFORMANCE:")
            self.logger.info(f"   Computation Time: {step_data['computation_time']:.4f} s")
            self.logger.info(f"   Memory Usage: {step_data.get('memory_usage', 'N/A')}")
    
    def log_loss_details(self, loss_data):
        """记录损失函数详细信息"""
        self.logger.info(f"📉 LOSS CALCULATION:")
        self.logger.info(f"   Actor Loss: {loss_data['actor_loss']:.6f}")
        self.logger.info(f"   Critic Loss: {loss_data['critic_loss']:.6f}")
        self.logger.info(f"   TD Error: {loss_data.get('td_error', 'N/A'):.6f}")
        self.logger.info(f"   Policy Entropy: {loss_data.get('entropy', 'N/A'):.6f}")
        
        # 记录到历史
        self.metrics_history['actor_loss'].append(loss_data['actor_loss'])
        self.metrics_history['critic_loss'].append(loss_data['critic_loss'])
    
    def log_statistics_summary(self):
        """记录统计摘要"""
        if self.step_count % self.summary_interval == 0:
            self.logger.info("📈 PERFORMANCE STATISTICS SUMMARY:")
            
            for metric, values in self.metrics_history.items():
                if values:
                    recent_values = values[-self.summary_interval:]
                    self.logger.info(f"   {metric.upper()} (last {len(recent_values)} steps):")
                    self.logger.info(f"      Mean: {np.mean(recent_values):.6f}")
                    self.logger.info(f"      Std:  {np.std(recent_values):.6f}")
                    self.logger.info(f"      Min:  {np.min(recent_values):.6f}")
                    self.logger.info(f"      Max:  {np.max(recent_values):.6f}")
    
    def log_error(self, error_msg, exception=None):
        """记录错误信息"""
        self.logger.error(f"❌ SAC ERROR: {error_msg}")
        if exception:
            self.logger.error(f"   Exception: {str(exception)}")
    
    def log_warning(self, warning_msg):
        """记录警告信息"""
        self.logger.warn(f"⚠️ SAC WARNING: {warning_msg}")

# ======================================================================================
# Model Definition (正确的训练模型架构)
# ======================================================================================

class SimplerVelocityLSTM(nn.Module):
    """
    A simpler version that directly maps the entire input sequence to output sequence.
    This approach is more straightforward and might work better initially.
    """
    
    def __init__(self, input_size=13, hidden_size=256, num_layers=2, output_seq_len=50, dropout=0.2):
        super(SimplerVelocityLSTM, self).__init__()
        
        self.input_size = input_size
        self.hidden_size = hidden_size
        self.num_layers = num_layers
        self.output_seq_len = output_seq_len
        
        # LSTM layers
        self.lstm = nn.LSTM(
            input_size=input_size,
            hidden_size=hidden_size,
            num_layers=num_layers,
            dropout=dropout if num_layers > 1 else 0,
            batch_first=True
        )
        
        # Direct mapping to output sequence
        self.output_layer = nn.Linear(hidden_size, output_seq_len)
        
    def forward(self, x):
        """
        Forward pass: encode input sequence, then decode to output sequence.
        
        Args:
            x: Input tensor of shape (batch_size, input_seq_len, num_features)
            
        Returns:
            output: Predicted velocity sequence of shape (batch_size, output_seq_len, 1)
        """
        batch_size = x.size(0)
        
        # Initialize hidden state
        h0 = torch.zeros(self.num_layers, batch_size, self.hidden_size).to(x.device)
        c0 = torch.zeros(self.num_layers, batch_size, self.hidden_size).to(x.device)
        
        # Forward through LSTM
        lstm_out, _ = self.lstm(x, (h0, c0))
        
        # Use the last output to predict the entire future sequence
        last_output = lstm_out[:, -1, :]  # Shape: (batch_size, hidden_size)
        predictions = self.output_layer(last_output)  # Shape: (batch_size, output_seq_len)
        
        # Reshape to match expected output format
        output = predictions.unsqueeze(-1)  # Shape: (batch_size, output_seq_len, 1)
        
        return output

# ======================================================================================
# Neural Network Planner Node with Time-Space Domain Mapping + SAC Components
# ======================================================================================

class NNPlannerNode(Node):
    def __init__(self):
        super().__init__('new_sac_gym_env_node')
        
        self.get_logger().info("🎯 Starting SAC Integration Phase...")
        self.get_logger().info(f"📊 Adjusted Reward Weights:")
        self.get_logger().info(f"   Progress Weight: 3.0 (强化速度奖励)")
        self.get_logger().info(f"   Center Weight: 2.0 (平衡中线保持)")
        self.get_logger().info(f"   Smoothness Weight: 0.1")
        self.get_logger().info(f"   Efficiency Weight: 1.0 (新增)")
        
        # 时空域映射参数
        self.prediction_horizon_meters = self.declare_parameter('prediction_horizon_meters', 200.0).value
        self.transition_zone_length = 0  # 关闭过渡区域约束
        self.time_step = self.declare_parameter('time_step', 0.1).value
        self.max_acceleration = self.declare_parameter('max_acceleration', 2.0).value
        self.enable_velocity_constraints = False  # 关闭速度连续性约束
        self.enable_debug_logs = self.declare_parameter('enable_debug_logs', False).value  # 默认关闭调试日志
        
        # SAC相关参数
        self.enable_sac_calculation = self.declare_parameter('enable_sac_calculation', True).value
        self.sac_debug_logging = self.declare_parameter('sac_debug_logging', True).value
        
        # 调试日志计数器
        self.debug_log_counter = 0
        self.debug_log_interval = 50  # 每50个周期输出一次汇总日志
        
        self.get_logger().info(f"Prediction horizon: {self.prediction_horizon_meters}m")
        if self.transition_zone_length > 0:
            self.get_logger().info(f"Transition zone length: {self.transition_zone_length} points")
        else:
            self.get_logger().info("Transition zone: DISABLED")
        self.get_logger().info(f"Time step: {self.time_step}s")
        if self.enable_velocity_constraints:
            self.get_logger().info(f"Max acceleration: {self.max_acceleration} m/s²")
        else:
            self.get_logger().info("Velocity continuity constraints: DISABLED")
            
        self.get_logger().info(f"SAC calculation: {'ENABLED' if self.enable_sac_calculation else 'DISABLED'}")
        self.get_logger().info(f"SAC debug logging: {'ENABLED' if self.sac_debug_logging else 'DISABLED'}")

        # Load model - 使用正确的模型架构
        model_path = self.declare_parameter('model_path', '/aichallenge/nn_planner_dev/training_output/best_model.pth').value
        self.get_logger().info(f"--- Loading LSTM model from: {model_path} ---")
        self.device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
        
        # 使用与训练时完全一致的模型架构
        self.model = SimplerVelocityLSTM(
            input_size=13, 
            hidden_size=256, 
            num_layers=2, 
            output_seq_len=50, 
            dropout=0.2
        )
        
        self.model.load_state_dict(torch.load(model_path, map_location=self.device))
        self.model.to(self.device)
        self.model.eval()
        self.get_logger().info("--- LSTM model loaded successfully and set to evaluation mode. ---")

        # SAC组件初始化
        if self.enable_sac_calculation:
            self.sac_components = self._initialize_sac_components()
            self.training_mode = False  # 此阶段不实际训练

        # 修复QoS兼容性问题
        # 使用BEST_EFFORT可靠性策略以匹配发布者
        qos_profile = QoSProfile(
            depth=1,
            reliability=ReliabilityPolicy.BEST_EFFORT,
            durability=DurabilityPolicy.VOLATILE
        )

        # Subscribers with corrected QoS
        self.kinematic_state_sub = self.create_subscription(Odometry, "/localization/kinematic_state", self._kinematic_state_callback, qos_profile)
        self.original_trajectory_sub = self.create_subscription(Trajectory, "/planning/scenario_planning/original_trajectory", self._original_trajectory_callback, qos_profile)

        # Publisher  
        self.trajectory_pub = self.create_publisher(Trajectory, "/planning/scenario_planning/trajectory", 1)

        # State variables
        self.current_odometry = None
        self.original_trajectory_msg = None  # 存储原始轨迹消息
        self.static_path_pts = None  # 存储静态路径点
        self.is_model_loaded = True  # Model is loaded in __init__
        
        # 时空域映射缓存
        self.velocity_mapping_cache = {}
        self.last_mapping_update_time = None
        self.last_position_index = None
        self.dt = self.time_step  # 添加时间步长变量

        # Create a timer that attempts to plan and publish
        self.create_timer(0.1, self.planner_callback)  # 10Hz planning
        
        self.get_logger().info("🚀 SAC Integration Phase Complete - Ready for detailed monitoring!")
        self.get_logger().info("NN Planner Node initialized successfully")

    def _initialize_sac_components(self):
        """初始化SAC相关组件（增强版）"""
        self.get_logger().info("🚀 Initializing SAC components...")
        
        state_dim = 90 * 13  # 展平后的状态维度
        action_dim = 1
        
        components = {
            'state_manager': SACStateManager(),
            'action_manager': SACActionManager(), 
            'reward_calculator': SACRewardCalculator(),
            'actor': SACActorNetwork(state_dim, action_dim).to(self.device),
            'critic1': SACCriticNetwork(state_dim, action_dim).to(self.device),
            'critic2': SACCriticNetwork(state_dim, action_dim).to(self.device),
            'target_critic1': SACCriticNetwork(state_dim, action_dim).to(self.device),
            'target_critic2': SACCriticNetwork(state_dim, action_dim).to(self.device),
        }
        
        # 初始化目标网络
        components['target_critic1'].load_state_dict(components['critic1'].state_dict())
        components['target_critic2'].load_state_dict(components['critic2'].state_dict())
        
        # 初始化日志系统
        self.sac_logger = SACLogger(self.get_logger())
        self.sac_logger.log_sac_initialization(components)
        
        # 验证组件
        self._validate_sac_components(components)
        
        return components

    def _validate_sac_components(self, components):
        """验证SAC组件的正确性"""
        self.get_logger().info("🔍 Validating SAC components...")
        
        try:
            # 测试状态维度
            dummy_state = torch.randn(1, 90 * 13).to(self.device)
            dummy_action = torch.randn(1, 1).to(self.device)
            
            # 测试Actor
            mean, log_std = components['actor'](dummy_state)
            assert mean.shape == (1, 1), f"Actor output shape error: {mean.shape}"
            self.get_logger().info("✅ Actor validation passed")
            
            # 测试Critic
            q1, q2 = components['critic1'](dummy_state, dummy_action)
            assert q1.shape == (1, 1), f"Critic output shape error: {q1.shape}"
            self.get_logger().info("✅ Critic validation passed")
            
            # 测试奖励计算
            dummy_state_info = {
                'velocity': 5.0,
                'distance_from_centerline': 0.5,
                'heading_error': 0.1
            }
            reward, terminated, components_reward = components['reward_calculator'].calculate_reward(
                dummy_state_info, [5.0], dummy_state_info
            )
            assert isinstance(reward, (int, float)), "Reward calculation failed"
            self.get_logger().info("✅ Reward calculation validation passed")
            
            self.get_logger().info("🎉 All SAC components validated successfully!")
            
        except Exception as e:
            self.sac_logger.log_error("SAC component validation failed", e)
            raise

    def planner_callback(self):
        """
        使用时空域映射+路径拼接的主规划回调函数，增加SAC计算
        """
        self.planning_start_time = time.time()
        
        # 检查所有必需的数据是否就绪
        if (self.current_odometry is None or 
            self.original_trajectory_msg is None or 
            self.static_path_pts is None or 
            not hasattr(self, 'model')):
            return  # 等待所有必需的数据

        # 检查原始轨迹是否为空
        if len(self.original_trajectory_msg.points) == 0:
            return

        try:
            # 整合的规划周期开始标记
            if self.enable_debug_logs and (self.debug_log_counter % self.debug_log_interval == 0):
                self.get_logger().info("=== PLANNING CYCLE START ===")

            # LSTM推理
            predicted_velocities = self.run_model_inference()
            if predicted_velocities is None:
                self.get_logger().error("LSTM inference failed, falling back to original trajectory")
                self.trajectory_pub.publish(self.original_trajectory_msg)
                return

            # 时空域映射
            velocity_mapping = self.time_to_space_mapping(predicted_velocities)

            # 创建混合轨迹
            hybrid_trajectory = self.create_hybrid_trajectory(velocity_mapping)

            # 发布轨迹
            self.trajectory_pub.publish(hybrid_trajectory)

            # SAC计算（不实际训练）
            if self.enable_sac_calculation:
                self._run_sac_calculation()

        except Exception as e:
            self.get_logger().error(f"Planning failed: {e}")
            # 发布原始轨迹作为后备
            self.trajectory_pub.publish(self.original_trajectory_msg)

    def time_to_space_mapping(self, predicted_velocities):
        """
        简化的时空域映射：直接将LSTM预测的50个速度值应用到前方50个路径点
        """
        current_position_idx = self._find_closest_path_idx(self.current_odometry, self.static_path_pts)
        current_velocity = self.current_odometry.twist.twist.linear.x

        # 关闭速度连续性约束，直接使用LSTM原始预测
        corrected_velocities = predicted_velocities  # 不再调用ensure_velocity_continuity
        
        # 简化的直接映射：前50个路径点使用LSTM速度
        velocity_mapping = {}
        for i in range(min(50, len(corrected_velocities))):
            path_idx = current_position_idx + 1 + i
            if path_idx < len(self.static_path_pts):
                velocity_mapping[path_idx] = corrected_velocities[i]

        # 整合的调试日志输出
        self.debug_log_counter += 1
        if self.enable_debug_logs and (self.debug_log_counter % self.debug_log_interval == 1):
            mapped_velocities = list(velocity_mapping.values())
            if mapped_velocities:
                self.get_logger().info(f"=== LSTM MAPPING SUMMARY (Cycle {self.debug_log_counter}) ===")
                self.get_logger().info(f"Vehicle position: {current_position_idx}, velocity: {current_velocity:.2f} m/s")
                self.get_logger().info(f"LSTM coverage: points {min(velocity_mapping.keys())}-{max(velocity_mapping.keys())} ({len(velocity_mapping)} points)")
                self.get_logger().info(f"Velocity range: [{min(mapped_velocities):.2f}, {max(mapped_velocities):.2f}] m/s")
                self.get_logger().info(f"Mean velocity: {np.mean(mapped_velocities):.2f} m/s")

        return velocity_mapping

    def ensure_velocity_continuity(self, current_velocity, predicted_velocities):
        """
        确保速度序列的物理可行性
        """
        corrected_velocities = []
        last_velocity = current_velocity

        continuity_violations = 0
        
        for i, predicted_v in enumerate(predicted_velocities):
            max_delta_v = self.max_acceleration * self.dt
            
            if abs(predicted_v - last_velocity) > max_delta_v:
                continuity_violations += 1
                if predicted_v > last_velocity:
                    corrected_v = last_velocity + max_delta_v
                else:
                    corrected_v = last_velocity - max_delta_v
                
                if self.enable_debug_logs and continuity_violations <= 3:  # 只记录前3个违规
                    self.get_logger().info(f"Velocity continuity correction at step {i}: {predicted_v:.2f} -> {corrected_v:.2f} m/s")
            else:
                corrected_v = predicted_v
                
            corrected_velocities.append(corrected_v)
            last_velocity = corrected_v

        if self.enable_debug_logs:
            self.get_logger().info(f"Velocity continuity check: {continuity_violations}/{len(predicted_velocities)} violations corrected")

        return corrected_velocities

    def create_hybrid_trajectory(self, velocity_mapping):
        """
        创建混合轨迹：保持完整CSV路径，用LSTM速度覆盖前方短期路径段
        """
        # 直接使用完整的原始轨迹作为基础
        output_trajectory = Trajectory()
        output_trajectory.header.stamp = self.get_clock().now().to_msg()
        output_trajectory.header.frame_id = "map"

        lstm_applied_count = 0
        original_used_count = 0

        # 发布完整的原始轨迹（所有121个点）
        for i, original_point in enumerate(self.original_trajectory_msg.points):
            # 复制原始轨迹点
            traj_point = type(original_point)()
            traj_point.pose = original_point.pose
            traj_point.longitudinal_velocity_mps = original_point.longitudinal_velocity_mps
            traj_point.lateral_velocity_mps = original_point.lateral_velocity_mps
            traj_point.acceleration_mps2 = original_point.acceleration_mps2
            traj_point.heading_rate_rps = original_point.heading_rate_rps
            traj_point.front_wheel_angle_rad = original_point.front_wheel_angle_rad
            traj_point.rear_wheel_angle_rad = original_point.rear_wheel_angle_rad

            # 应用LSTM速度（无过渡区域，直接覆盖）
            if i in velocity_mapping:
                traj_point.longitudinal_velocity_mps = float(velocity_mapping[i])
                lstm_applied_count += 1
            else:
                # 使用原始CSV速度
                original_used_count += 1

            output_trajectory.points.append(traj_point)

        total_points = len(output_trajectory.points)
        
        # 整合的调试日志输出
        if self.enable_debug_logs and (self.debug_log_counter % self.debug_log_interval == 1):
            self.get_logger().info(f"=== TRAJECTORY SUMMARY ===")
            self.get_logger().info(f"Total points: {total_points}")
            self.get_logger().info(f"LSTM controlled: {lstm_applied_count} points ({lstm_applied_count/total_points*100:.1f}%)")
            self.get_logger().info(f"CSV original: {original_used_count} points ({original_used_count/total_points*100:.1f}%)")

        return output_trajectory

    def publish_fallback_trajectory(self):
        """
        发布后备轨迹（完整的原始CSV轨迹）
        """
        if self.original_trajectory_msg is not None:
            fallback_trajectory = Trajectory()
            fallback_trajectory.header.stamp = self.get_clock().now().to_msg()
            fallback_trajectory.header.frame_id = "map"
            
            # 发布完整的原始轨迹
            for original_point in self.original_trajectory_msg.points:
                fallback_trajectory.points.append(original_point)
            
            self.trajectory_pub.publish(fallback_trajectory)
            
            if self.enable_debug_logs:
                self.get_logger().warn(f"Published complete fallback trajectory with {len(fallback_trajectory.points)} points")

    def run_model_inference(self):
        """
        运行LSTM模型推理，包含整合的调试信息
        """
        # 1. Compute the feature vector for the current state
        features = self._compute_features_now()
        if features is None:
            return None

        # 2. Create a dummy sequence for the model input
        # The model was trained on sequences, but for real-time inference,
        # we use the most current feature vector and replicate it.
        input_seq_len = 149 # Based on the training script (3s at ~50Hz)
        input_data = np.tile(features, (input_seq_len, 1))
        
        # 3. Convert to tensor and add batch dimension
        input_tensor = torch.from_numpy(input_data).float().unsqueeze(0).to(self.device)

        # 4. Run inference
        inference_start_time = time.time()
        try:
            with torch.no_grad():
                predictions_tensor = self.model(input_tensor)
        except Exception as e:
            self.get_logger().error(f"LSTM model inference failed: {e}")
            return None
            
        inference_time = time.time() - inference_start_time
        
        # 5. Convert back to numpy array and flatten
        predicted_velocities = predictions_tensor.squeeze().cpu().numpy()
        
        # 整合的推理日志输出
        if self.enable_debug_logs and (self.debug_log_counter % self.debug_log_interval == 0):
            self.get_logger().info(f"=== LSTM INFERENCE SUMMARY ===")
            self.get_logger().info(f"Current velocity: {features[0]:.2f} m/s, Angular velocity: {features[1]:.3f} rad/s")
            self.get_logger().info(f"Distance from centerline: {features[2]:.3f} m, Heading error: {features[3]:.3f} rad")
            self.get_logger().info(f"Inference time: {inference_time*1000:.2f}ms")
            self.get_logger().info(f"Predicted velocity range: [{predicted_velocities.min():.2f}, {predicted_velocities.max():.2f}] m/s")
            self.get_logger().info(f"Mean predicted velocity: {predicted_velocities.mean():.2f} m/s")
            
        return predicted_velocities

    # ======================================================================================
    # Feature Engineering (Copied from nn_planner_dev/post_process.py)
    # ======================================================================================
    
    def _compute_features_now(self):
        state_pose = self.current_odometry.pose.pose
        state_twist = self.current_odometry.twist.twist
        
        # Ego state
        current_velocity_x = state_twist.linear.x
        current_angular_velocity_z = state_twist.angular.z
        
        # Path-relative features
        closest_idx = self._find_closest_path_idx(self.current_odometry, self.static_path_pts)
        closest_pt = self.static_path_pts[closest_idx]
        
        distance = np.linalg.norm(np.array([state_pose.position.x, state_pose.position.y]) - closest_pt)
        path_vec = self.static_path_pts[min(closest_idx + 1, len(self.static_path_pts)-1)] - self.static_path_pts[max(closest_idx - 1, 0)]
        ego_vec = np.array([state_pose.position.x, state_pose.position.y]) - closest_pt
        cross_prod_z = np.cross(path_vec, ego_vec)
        distance_from_centerline = np.copysign(distance, cross_prod_z)
        
        quat = state_pose.orientation
        ego_yaw = R.from_quat([quat.x, quat.y, quat.z, quat.w]).as_euler('xyz', degrees=False)[2]
        path_yaw = np.arctan2(path_vec[1], path_vec[0])
        heading_error = (ego_yaw - path_yaw + np.pi) % (2 * np.pi) - np.pi
        
        # Curvature fingerprint
        sample_distances = [-25, -15, -10, -5, 0, 5, 10, 15, 25]
        curvature_features = []
        for dist in sample_distances:
            sample_idx = self._get_path_point_at_distance(self.static_path_pts, closest_idx, dist)
            p2 = self.static_path_pts[sample_idx]
            p1 = self.static_path_pts[max(0, sample_idx - 5)]
            p3 = self.static_path_pts[min(len(self.static_path_pts) - 1, sample_idx + 5)]
            curvature = self._calculate_curvature(p1, p2, p3) if not (np.array_equal(p1, p2) or np.array_equal(p2, p3)) else 0.0
            curvature_features.append(curvature)
            
        return np.concatenate([[current_velocity_x, current_angular_velocity_z, distance_from_centerline, heading_error], curvature_features])

    def _find_closest_path_idx(self, state, path_pts):
        pos = state.pose.pose.position
        return np.argmin(np.linalg.norm(path_pts - np.array([pos.x, pos.y]), axis=1))

    def _get_path_point_at_distance(self, path_pts, start_idx, distance):
        if distance == 0: return start_idx
        current_dist = 0.0
        if distance > 0:
            for i in range(start_idx, len(path_pts) - 1):
                current_dist += np.linalg.norm(path_pts[i+1] - path_pts[i])
                if current_dist >= distance: return i + 1
            return len(path_pts) - 1
        else:
            for i in range(start_idx, 0, -1):
                current_dist += np.linalg.norm(path_pts[i-1] - path_pts[i])
                if current_dist >= abs(distance): return i - 1
            return 0

    def _calculate_curvature(self, p1, p2, p3):
        a, b, c = np.linalg.norm(p2 - p3), np.linalg.norm(p1 - p3), np.linalg.norm(p1 - p2)
        if a * b * c == 0: return 0.0
        s = (a + b + c) / 2
        area_sq = s * (s - a) * (s - b) * (s - c)
        if area_sq <= 0: return 0.0
        area = np.sqrt(area_sq)
        curvature = (4 * area) / (a * b * c)
        cross_product_z = (p2[0] - p1[0]) * (p3[1] - p2[1]) - (p2[1] - p1[1]) * (p3[0] - p2[0])
        return np.copysign(curvature, cross_product_z)

    def _kinematic_state_callback(self, msg: Odometry):
        """
        处理运动学状态回调
        """
        self.current_odometry = msg

    def _original_trajectory_callback(self, msg: Trajectory):
        """
        处理原始轨迹回调，提取静态路径点
        """
        self.original_trajectory_msg = msg
        
        # 从轨迹中提取静态路径点 (x, y坐标)
        if len(msg.points) > 0:
            self.static_path_pts = np.array([
                [point.pose.position.x, point.pose.position.y] 
                for point in msg.points
            ])
            
            # 只在静态路径首次加载时记录日志
            if not hasattr(self, '_path_loaded'):
                self.get_logger().info(f"Static path loaded with {len(self.static_path_pts)} points")
                self._path_loaded = True

    def _run_sac_calculation(self):
        """运行SAC计算流程（增强日志版本）"""
        start_time = time.time()
        
        try:
            # 1. 状态提取
            current_state = self._extract_sac_state()
            if current_state is None:
                if self.sac_debug_logging:
                    self.sac_logger.log_warning("State extraction failed - skipping SAC calculation")
                return
                
            # 2. Actor前向传播
            with torch.no_grad():
                state_tensor = torch.FloatTensor(current_state).unsqueeze(0).to(self.device)
                
                # 调试信息
                if self.sac_debug_logging and hasattr(self, 'debug_step_counter'):
                    if not hasattr(self, 'debug_step_counter'):
                        self.debug_step_counter = 0
                    self.debug_step_counter += 1
                    if self.debug_step_counter % 50 == 1:  # 每50步打印一次
                        self.get_logger().info(f"Actor input shape: {state_tensor.shape}")
                
                mean, log_std = self.sac_components['actor'](state_tensor)
                std = log_std.exp()
                
                # 采样动作
                normal = torch.distributions.Normal(mean, std)
                action_sample = normal.rsample()
                action = torch.tanh(action_sample) * 5.0 + 5.0  # 映射到[0,10]
                
                # 调试动作形状
                if self.sac_debug_logging and hasattr(self, 'debug_step_counter') and self.debug_step_counter % 50 == 1:
                    self.get_logger().info(f"Action shapes - mean: {mean.shape}, action: {action.shape}")
                
                # 计算动作统计
                action_stats = {
                    'action_mean': mean.item(),
                    'action_std': std.item(),
                    'final_action': action.item(),
                    'action_min': 0.0,
                    'action_max': 10.0
                }
                
            # 3. Critic前向传播
            with torch.no_grad():
                q1, q2 = self.sac_components['critic1'](state_tensor, action)
                target_q1, target_q2 = self.sac_components['target_critic1'](state_tensor, action)
                
                critic_stats = {
                    'q1_value': q1.item(),
                    'q2_value': q2.item(),
                    'target_q1': target_q1.item(),
                    'target_q2': target_q2.item()
                }
                
            # 4. 状态信息提取
            state_info = self._extract_state_info()
            
            # 5. 奖励计算
            reward, terminated, reward_components = self.sac_components['reward_calculator'].calculate_reward(
                state_info, action.cpu().numpy()[0], state_info
            )
            
            # 6. Loss计算（不反向传播）
            loss_data = {}
            if hasattr(self, 'last_state') and hasattr(self, 'last_action'):
                actor_loss, critic_loss, additional_metrics = self._calculate_sac_losses(
                    self.last_state, self.last_action, reward, current_state, terminated
                )
                
                loss_data = {
                    'actor_loss': actor_loss,
                    'critic_loss': critic_loss,
                    **additional_metrics
                }
                
                if self.sac_debug_logging:
                    self.sac_logger.log_loss_details(loss_data)
            
            # 7. 性能统计
            computation_time = time.time() - start_time
            memory_usage = self._get_memory_usage() if hasattr(self, '_get_memory_usage') else "N/A"
            
            # 8. 综合日志记录
            if self.sac_debug_logging:
                step_data = {
                    **action_stats,
                    **critic_stats,
                    'reward_components': reward_components,
                    'state_info': state_info,
                    'computation_time': computation_time,
                    'memory_usage': memory_usage
                }
                
                self.sac_logger.log_step_details(step_data)
                
                # 记录统计数据
                self.sac_logger.metrics_history['actions'].append(action.item())
                self.sac_logger.metrics_history['rewards'].append(reward)
                self.sac_logger.metrics_history['q1_values'].append(q1.item())
                self.sac_logger.metrics_history['q2_values'].append(q2.item())
                self.sac_logger.metrics_history['computation_time'].append(computation_time)
                
                # 定期统计摘要
                self.sac_logger.log_statistics_summary()
                
                # 性能警告
                if computation_time > 0.05:
                    self.sac_logger.log_warning(f"SAC calculation took {computation_time:.4f}s (>50ms limit)")
                
                # 异常值检测
                self._detect_anomalies(step_data, loss_data)
            
            # 保存当前状态用于下次计算
            self.last_state = current_state
            self.last_action = action.cpu().numpy().flatten()  # 确保是1D numpy数组
            
        except Exception as e:
            if self.sac_debug_logging:
                self.sac_logger.log_error(f"SAC calculation failed", e)
                import traceback
                self.get_logger().error(f"Full traceback: {traceback.format_exc()}")

    def _extract_sac_state(self):
        """提取SAC状态特征"""
        try:
            # 获取13维特征向量
            features = self._compute_features_now()
            if features is None:
                return None
            
            # 使用状态管理器构建完整的状态序列
            state_sequence = self.sac_components['state_manager'].extract_state_features(features)
            return state_sequence
            
        except Exception as e:
            if self.sac_debug_logging:
                self.sac_logger.log_error(f"State extraction failed", e)
            return None

    def _extract_state_info(self):
        """提取状态信息用于奖励计算"""
        try:
            features = self._compute_features_now()
            if features is None:
                return {}
            
            return {
                'velocity': features[0],
                'angular_velocity': features[1],
                'distance_from_centerline': features[2],
                'heading_error': features[3]
            }
            
        except Exception as e:
            if self.sac_debug_logging:
                self.sac_logger.log_error(f"State info extraction failed", e)
            return {}

    def _calculate_sac_losses(self, state, action, reward, next_state, terminated):
        """计算SAC损失函数（不反向传播）"""
        with torch.no_grad():
            # 转换为tensor
            state_t = torch.FloatTensor(state).unsqueeze(0).to(self.device)
            # 确保action是正确的形状 - 修复维度问题
            if isinstance(action, np.ndarray):
                if action.ndim == 0:  # 标量
                    action_t = torch.FloatTensor([action]).unsqueeze(0).to(self.device)
                elif action.ndim == 1:  # 1D数组
                    action_t = torch.FloatTensor(action).unsqueeze(0).to(self.device)
                else:  # 已经是正确形状
                    action_t = torch.FloatTensor(action).to(self.device)
            else:  # 如果是tensor
                action_t = action.view(1, -1)  # 确保是 (batch_size, action_dim)
            
            reward_t = torch.FloatTensor([reward]).to(self.device)
            next_state_t = torch.FloatTensor(next_state).unsqueeze(0).to(self.device)
            done_t = torch.FloatTensor([terminated]).to(self.device)
            
            # 调试信息
            if self.sac_debug_logging:
                self.get_logger().info(f"Debug shapes - state_t: {state_t.shape}, action_t: {action_t.shape}")
            
            # Critic损失
            current_q1, current_q2 = self.sac_components['critic1'](state_t, action_t)
            
            # 目标Q值计算
            next_mean, next_log_std = self.sac_components['actor'](next_state_t)
            next_std = next_log_std.exp()
            next_normal = torch.distributions.Normal(next_mean, next_std)
            next_action_sample = next_normal.rsample()
            next_action = torch.tanh(next_action_sample) * 5.0 + 5.0
            
            target_q1, target_q2 = self.sac_components['target_critic1'](next_state_t, next_action)
            target_q = torch.min(target_q1, target_q2)
            target = reward_t + (1 - done_t) * 0.99 * target_q  # gamma=0.99
            
            critic_loss = F.mse_loss(current_q1, target) + F.mse_loss(current_q2, target)
            
            # Actor损失
            mean, log_std = self.sac_components['actor'](state_t)
            std = log_std.exp()
            normal = torch.distributions.Normal(mean, std)
            action_sample = normal.rsample()
            action_pred = torch.tanh(action_sample) * 5.0 + 5.0
            
            q1_pred, q2_pred = self.sac_components['critic1'](state_t, action_pred)
            q_pred = torch.min(q1_pred, q2_pred)
            
            log_prob = normal.log_prob(action_sample).sum(-1, keepdim=True)
            log_prob -= (2 * (np.log(2) - action_sample - F.softplus(-2 * action_sample))).sum(-1, keepdim=True)
            
            actor_loss = (0.2 * log_prob - q_pred).mean()  # alpha=0.2
            
            # TD误差和熵
            td_error = torch.abs(current_q1 - target).mean()
            entropy = -log_prob.mean()
            
            return actor_loss.item(), critic_loss.item(), {
                'td_error': td_error.item(),
                'entropy': entropy.item()
            }

    def _detect_anomalies(self, step_data, loss_data):
        """检测异常值并记录警告"""
        # Q值异常检测
        q1, q2 = step_data['q1_value'], step_data['q2_value']
        if abs(q1) > 1000 or abs(q2) > 1000:
            self.sac_logger.log_warning(f"Q values are very large: Q1={q1:.2f}, Q2={q2:.2f}")
        
        # 动作异常检测
        action = step_data['final_action']
        if action < 0 or action > 10:
            self.sac_logger.log_warning(f"Action out of bounds: {action:.4f}")
        
        # 损失异常检测
        if loss_data:
            if loss_data['actor_loss'] > 100:
                self.sac_logger.log_warning(f"Actor loss very high: {loss_data['actor_loss']:.6f}")
            if loss_data['critic_loss'] > 100:
                self.sac_logger.log_warning(f"Critic loss very high: {loss_data['critic_loss']:.6f}")

    def _get_memory_usage(self):
        """获取内存使用情况"""
        try:
            if torch.cuda.is_available():
                return f"{torch.cuda.memory_allocated()/1024**2:.1f}MB"
            else:
                return "CPU"
        except:
            return "N/A"


def main(args=None):
    rclpy.init(args=args)
    node = NNPlannerNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        node.get_logger().info("Shutting down NN Planner Node...")
    finally:
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main() 