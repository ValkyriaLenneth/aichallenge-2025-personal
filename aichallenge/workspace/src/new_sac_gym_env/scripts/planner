# ======================================================================================
# SAC Components - V2 Architecture (End-to-End LSTM-SAC)
# ======================================================================================

class LSTMFeatureExtractor(nn.Module):
    """
    V2架构: 从序列输入中提取特征向量。
    严格遵循开发文档 6.1.1 节规范。
    """
    def __init__(self, input_size=13, hidden_size=256, num_layers=2, dropout=0.2):
        super().__init__()
        self.lstm = nn.LSTM(
            input_size, 
            hidden_size, 
            num_layers,
            batch_first=True, 
            dropout=dropout if num_layers > 1 else 0
        )
    
    def forward(self, x):  # x: [batch, seq_len, 13]
        # lstm_out: [batch, seq_len, hidden_size]
        # h_n: [num_layers, batch, hidden_size]
        lstm_out, (h_n, c_n) = self.lstm(x)
        # 返回最后一层的隐状态作为特征向量
        return h_n[-1]  # Shape: [batch, hidden_size]

class SACActorNetwork(nn.Module):
    """
    V2架构: 集成LSTM特征提取器，输出单一动作的目标速度分布。
    严格遵循开发文档 6.1.2 节规范。
    """
    def __init__(self, feature_dim=256, action_dim=1, hidden_dim=256):
        super().__init__()
        self.feature_extractor = LSTMFeatureExtractor()
        
        self.policy_net = nn.Sequential(
            nn.Linear(feature_dim, hidden_dim), 
            nn.ReLU(),
            nn.Linear(hidden_dim, hidden_dim), 
            nn.ReLU()
        )
        self.mean_head = nn.Linear(hidden_dim, action_dim)
        self.log_std_head = nn.Linear(hidden_dim, action_dim)
        
    def forward(self, sequence_input): # sequence_input: [batch, seq_len, 13]
        features = self.feature_extractor(sequence_input)
        policy_features = self.policy_net(features)
        
        mean = self.mean_head(policy_features)
        log_std = self.log_std_head(policy_features)
        log_std = torch.clamp(log_std, -20, 2)
        return mean, log_std
    
    def sample(self, sequence_input):
        mean, log_std = self.forward(sequence_input)
        std = log_std.exp()
        normal = torch.distributions.Normal(mean, std)
        x_t = normal.rsample()  # for re-parameterization trick (mean + std * N(0,1))
        y_t = torch.tanh(x_t)
        action = y_t * 15.0 # Scale to action space [0, 15] - assuming [-1, 1] -> [0, 15] needs adjustment
        
        # Action scaling correction: Tanh is [-1, 1]. To map to [0, 15], we do (y_t + 1)/2 * 15
        action = (y_t + 1.0) / 2.0 * 15.0

        log_prob = normal.log_prob(x_t)
        # Enforcing Action Bound
        log_prob -= torch.log(1.0 - y_t.pow(2) + 1e-6)
        log_prob = log_prob.sum(-1, keepdim=True)
        return action, log_prob, mean


class SACCriticNetwork(nn.Module):
    """
    V2架构: 基于LSTM提取的特征向量和动作来评估Q值。
    """
    def __init__(self, feature_dim=256, action_dim=1, hidden_dim=256):
        super().__init__()
        # Q1 architecture
        self.q1 = nn.Sequential(
            nn.Linear(feature_dim + action_dim, hidden_dim), nn.ReLU(),
            nn.Linear(hidden_dim, hidden_dim), nn.ReLU(),
            nn.Linear(hidden_dim, 1)
        )
        # Q2 architecture
        self.q2 = nn.Sequential(
            nn.Linear(feature_dim + action_dim, hidden_dim), nn.ReLU(),
            nn.Linear(hidden_dim, hidden_dim), nn.ReLU(),
            nn.Linear(hidden_dim, 1)
        )
        
    def forward(self, features, action):
        sa = torch.cat([features, action], dim=-1)
        return self.q1(sa), self.q2(sa)

# ======================================================================================
# SAC Components - Managers and Logger (V2 Update)
# ======================================================================================

class SACStateManager:
    def __init__(self, sequence_length=90, feature_dim=13):
        # 观测空间：(90, 13) - 90个时间步，每步13个特征
        self.observation_space = spaces.Box(
            low=-np.inf, high=np.inf, 
            shape=(sequence_length, feature_dim), 
            dtype=np.float32
        )
        self.sequence_length = sequence_length
        self.feature_dim = feature_dim
        self.observation_buffer = deque(maxlen=self.sequence_length)
        
    def get_state(self, new_features):
        """
        将新的13维特征向量添加到观测缓冲区并返回完整状态序列。
        """
        # 添加当前特征到缓冲区
        self.observation_buffer.append(new_features)
        
        # 如果缓冲区未满，用零填充
        padded_buffer = list(self.observation_buffer)
        while len(padded_buffer) < self.sequence_length:
            padded_buffer.insert(0, np.zeros(self.feature_dim, dtype=np.float32))
        
        # 转换为numpy数组
        state_sequence = np.array(padded_buffer, dtype=np.float32)
        return state_sequence  # shape: (90, 13)

class SACActionManager:
    def __init__(self):
        # 动作空间：单一维度的目标速度, 范围[0, 15]
        self.action_space = spaces.Box(
            low=0.0, high=15.0, 
            shape=(1,), 
            dtype=np.float32
        )
        
    def process_action(self, action):
        """处理SAC输出的动作，转换为目标速度"""
        target_velocity = float(action[0])
        # 添加物理约束检查
        target_velocity = np.clip(target_velocity, 0.0, 15.0)
        return target_velocity

class ReplayBuffer:
    """
    标准的经验回放池，用于存储和采样 SAC 的经验元组。
    """
    def __init__(self, capacity=100000):
        self.buffer = deque(maxlen=capacity)

    def store(self, state, action, reward, next_state, done):
        """存储一个经验元组"""
        self.buffer.append((state, action, reward, next_state, done))

    def sample(self, batch_size):
        """从缓冲区中采样一个批次的经验"""
        batch = random.sample(self.buffer, batch_size)
        states, actions, rewards, next_states, dones = map(np.stack, zip(*batch))
        return (
            torch.FloatTensor(states),
            torch.FloatTensor(actions),
            torch.FloatTensor(rewards).unsqueeze(1),
            torch.FloatTensor(next_states),
            torch.FloatTensor(dones).unsqueeze(1)
        )

    def __len__(self):
        return len(self.buffer)


class SACRewardCalculator:
    """
    V2 奖励函数计算器。
    严格遵循开发文档第4节和第6.2节的规范。
    """
    def __init__(self):
        # 奖励函数权重 - V3 方案 (逻辑重构)
        self.W_SPEED_STRAIGHT = 8.0          # 直道速度奖励权重
        self.W_SPEED_CORNER = 6.0            # 弯道速度奖励权重
        self.W_TRACK_KEEPING = -5.0          # 轨道保持惩罚权重 (参考文档重新启用)
        self.W_SMOOTHNESS = -2.0             # 平滑性惩罚权重 (参考文档重新启用)
        self.W_TERMINATION_PENALTY = -100.0  # 终止惩罚
        self.W_OVERSPEED_PENALTY = -200.0    # 超速惩罚 (新增)

        # 其他参数
        self.MAX_DIST_FROM_CENTER = 3.0
        self.MAX_SPEED_MPS = 9.72              # 最大速度限制 (35km/h) (新增)
        self.CORNER_CURVATURE_THRESHOLD = 0.01
        self.CORNER_SPEED_LIMIT = 12.0
        self.LATERAL_ACCEL_LIMIT = 2.5 # m/s^2, 用于计算弯道最优速度

        self.last_action = None

    def calculate_reward(self, state_info, action, terminated):
        """
        根据 V3 统一方案计算奖励。
        解决了低速陷阱、增加了超速惩罚。

        Args:
            state_info (dict): 包含 'velocity', 'distance_from_centerline', 'curvature' 等的字典。
            action (float): Actor 在决策开始时输出的目标速度。
            terminated (bool): 是否触发终止条件。
        """
        current_velocity = state_info.get('velocity', 0.0)
        distance_from_centerline = state_info.get('distance_from_centerline', 0.0)
        curvature = state_info.get('curvature', 0.0)

        # 1. 超速惩罚 (最高优先级)
        if current_velocity > self.MAX_SPEED_MPS:
            return self.W_OVERSPEED_PENALTY, {
                'reward_total': self.W_OVERSPEED_PENALTY,
                'reward_penalty': self.W_OVERSPEED_PENALTY,
                'reason': 'overspeed'
            }

        # 2. 终止惩罚 (R_penalty)
        if terminated:
            return self.W_TERMINATION_PENALTY, {
                'reward_total': self.W_TERMINATION_PENALTY,
                'reward_penalty': self.W_TERMINATION_PENALTY,
                'reason': 'off_track'
            }

        # 3. 速度奖励 (R_speed) - 【核心修改】
        # 直接奖励 "选择" 合理速度的 "动作本身"，而不是去匹配一个延迟的当前速度
        if abs(curvature) < self.CORNER_CURVATURE_THRESHOLD: # 直道
            # 直接奖励选择高速动作的行为
            r_speed = self.W_SPEED_STRAIGHT * (action / 15.0)
        else: # 弯道
            # 奖励选择接近最优弯道速度的动作
            optimal_speed = np.sqrt(self.LATERAL_ACCEL_LIMIT / max(abs(curvature), 1e-6))
            optimal_speed = min(optimal_speed, self.CORNER_SPEED_LIMIT)
            speed_error = abs(action - optimal_speed) / max(optimal_speed, 1e-3)
            r_speed = self.W_SPEED_CORNER * max(0.0, 1.0 - speed_error)

        # 4. 轨道保持奖励 (R_track)
        r_track = self.W_TRACK_KEEPING * (distance_from_centerline ** 2)

        # 5. 平滑性奖励 (R_smoothness)
        if self.last_action is not None:
            speed_change = abs(action - self.last_action)
            r_smoothness = self.W_SMOOTHNESS * speed_change
        else:
            r_smoothness = 0.0
        
        # 注意: self.last_action 的更新移至主循环中，以匹配决策周期

        # 总奖励
        total_reward = r_speed + r_track + r_smoothness
        
        reward_components = {
            'reward_total': total_reward,
            'r_speed': r_speed,
            'r_track': r_track,
            'r_smoothness': r_smoothness,
        }

        return total_reward, reward_components

    def is_terminated(self, state_info):
        """
        根据状态判断是否应该终止。
        """
        distance_from_centerline = state_info.get('distance_from_centerline', 0.0)
        current_velocity = state_info.get('velocity', 0.0)

        # 偏离轨道
        if abs(distance_from_centerline) > self.MAX_DIST_FROM_CENTER:
            return True
        
        # 实际速度超速 (新增)
        if current_velocity > self.MAX_SPEED_MPS:
            return True
        
        return False


class SACLogger:
    def __init__(self, node_logger):
        self.logger = node_logger
        self.step_count = 0
        self.log_interval = 10  # 每10步详细日志一次
        self.summary_interval = 100  # 每100步统计日志一次
        
        # 统计数据
        self.metrics_history = {
            'actor_loss': [],
            'critic_loss': [],
            'q1_values': [],
            'q2_values': [],
            'actions': [],
            'rewards': [],
            'computation_time': []
        }
    
    def log_sac_initialization(self, components):
        """记录SAC组件初始化"""
        self.logger.info("=" * 80)
        self.logger.info("🚀 SAC COMPONENTS INITIALIZATION")
        self.logger.info("=" * 80)
        
        for name, component in components.items():
            if hasattr(component, 'parameters'):
                param_count = sum(p.numel() for p in component.parameters())
                self.logger.info(f"✅ {name.upper()}: {param_count:,} parameters")
            else:
                self.logger.info(f"✅ {name.upper()}: Initialized")
        
        self.logger.info("=" * 80)
    
    def log_step_details(self, step_data):
        """记录每步的详细信息"""
        self.step_count += 1
        
        if self.step_count % self.log_interval == 0:
            self.logger.info("─" * 60)
            self.logger.info(f"📊 SAC STEP {self.step_count} DETAILS")
            self.logger.info("─" * 60)
            
            # Actor信息
            self.logger.info(f"🎭 ACTOR:")
            self.logger.info(f"   Action Mean: {step_data['action_mean']:.4f}")
            self.logger.info(f"   Action Std:  {step_data['action_std']:.4f}")
            self.logger.info(f"   Final Action: {step_data['final_action']:.4f}")
            
            # Critic信息
            self.logger.info(f"🏛️ CRITIC:")
            self.logger.info(f"   Q1 Value: {step_data['q1_value']:.4f}")
            self.logger.info(f"   Q2 Value: {step_data['q2_value']:.4f}")
            self.logger.info(f"   Min Q Value: {min(step_data['q1_value'], step_data['q2_value']):.4f}")
            
            # 奖励详情
            if 'reward_components' in step_data:
                self.logger.info(f"🎯 REWARD BREAKDOWN:")
                for comp, value in step_data['reward_components'].items():
                    self.logger.info(f"   {comp.replace('_', ' ').title()}: {value:.4f}")
            
            # 状态信息
            if 'state_info' in step_data:
                self.logger.info(f"🚗 VEHICLE STATE:")
                self.logger.info(f"   Velocity: {step_data['state_info']['velocity']:.3f} m/s")
                self.logger.info(f"   Distance from Center: {step_data['state_info']['distance_from_centerline']:.3f} m")
                self.logger.info(f"   Heading Error: {step_data['state_info'].get('heading_error', 0):.3f} rad")
            
            # 性能信息
            self.logger.info(f"⚡ PERFORMANCE:")
            self.logger.info(f"   Computation Time: {step_data['computation_time']:.4f} s")
            self.logger.info(f"   Memory Usage: {step_data.get('memory_usage', 'N/A')}")
    
    def log_loss_details(self, loss_data):
        """记录损失函数详细信息"""
        self.logger.info(f"📉 LOSS CALCULATION:")
        self.logger.info(f"   Actor Loss: {loss_data['actor_loss']:.6f}")
        self.logger.info(f"   Critic Loss: {loss_data['critic_loss']:.6f}")
        self.logger.info(f"   TD Error: {loss_data.get('td_error', 'N/A'):.6f}")
        self.logger.info(f"   Policy Entropy: {loss_data.get('entropy', 'N/A'):.6f}")
        
        # 记录到历史
        self.metrics_history['actor_loss'].append(loss_data['actor_loss'])
        self.metrics_history['critic_loss'].append(loss_data['critic_loss'])
    
    def log_statistics_summary(self):
        """记录统计摘要"""
        if self.step_count % self.summary_interval == 0:
            self.logger.info("📈 PERFORMANCE STATISTICS SUMMARY:")
            
            for metric, values in self.metrics_history.items():
                if values:
                    recent_values = values[-self.summary_interval:]
                    self.logger.info(f"   {metric.upper()} (last {len(recent_values)} steps):")
                    self.logger.info(f"      Mean: {np.mean(recent_values):.6f}")
                    self.logger.info(f"      Std:  {np.std(recent_values):.6f}")
                    self.logger.info(f"      Min:  {np.min(recent_values):.6f}")
                    self.logger.info(f"      Max:  {np.max(recent_values):.6f}")
    
    def log_error(self, error_msg, exception=None):
        """记录错误信息"""
        self.logger.error(f"❌ SAC ERROR: {error_msg}")
        if exception:
            self.logger.error(f"   Exception: {str(exception)}")
    
    def log_warning(self, warning_msg):
        """记录警告信息"""
        self.logger.warn(f"⚠️ SAC WARNING: {warning_msg}")

# ======================================================================================
# Neural Network Planner Node with Time-Space Domain Mapping + SAC Components
# ======================================================================================

class NNPlannerNode(Node):
    def __init__(self):
        super().__init__('new_sac_gym_env_node')
        
        self.get_logger().info("🎯 Starting SAC Integration Phase...")
        
        # 时空域映射参数
        self.prediction_horizon_meters = self.declare_parameter('prediction_horizon_meters', 200.0).value
        self.transition_zone_length = 0  # 关闭过渡区域约束
        self.time_step = self.declare_parameter('time_step', 0.1).value
        self.max_acceleration = self.declare_parameter('max_acceleration', 2.0).value
        self.enable_velocity_constraints = False  # 关闭速度连续性约束
        self.enable_debug_logs = self.declare_parameter('enable_debug_logs', False).value  # 默认关闭调试日志
        
        # SAC相关参数
        self.enable_sac_calculation = self.declare_parameter('enable_sac_calculation', True).value
        self.sac_debug_logging = self.declare_parameter('sac_debug_logging', True).value
        
        # V3 方案: 决策与执行解耦
        self.decision_interval = 5  # 每5个周期 (0.5s) 做一次决策
        self.step_counter = 0
        self.last_action = 0.0  # 初始化要执行的动作
        self.last_decision_state_seq = None # 上一个决策周期的状态
        self.last_closest_idx = 0 # V4方案: 前进式路径点搜索
        
        # 调试日志计数器
        self.debug_log_counter = 0
        self.debug_log_interval = 50  # 每50个周期输出一次汇总日志
        
        self.get_logger().info(f"SAC calculation: {'ENABLED' if self.enable_sac_calculation else 'DISABLED'}")
        self.get_logger().info(f"SAC debug logging: {'ENABLED' if self.sac_debug_logging else 'DISABLED'}")

        # Load model - 使用正确的模型架构
        self.model_path = self.declare_parameter('model_path', '/aichallenge/nn_planner_dev/training_output/best_model.pth').value
        self.get_logger().info(f"Loading LSTM model from: {self.model_path}")
        self.device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
        
        self.get_logger().info("LSTM model loading deferred to SAC component initialization.")

        # SAC组件初始化
        if self.enable_sac_calculation:
            # V2 方案: 添加 ReplayBuffer
            self.replay_buffer = ReplayBuffer(capacity=100000)
            self.sac_components = self._initialize_sac_components()
            self.training_mode = True  # V2 方案: 开启训练模式

        # 修复QoS兼容性问题
        # 使用BEST_EFFORT可靠性策略以匹配发布者
        qos_profile = QoSProfile(
            depth=1,
            reliability=ReliabilityPolicy.BEST_EFFORT,
            durability=DurabilityPolicy.VOLATILE
        )

        # Subscribers with corrected QoS
        self.kinematic_state_sub = self.create_subscription(Odometry, "/localization/kinematic_state", self._kinematic_state_callback, qos_profile)
        self.original_trajectory_sub = self.create_subscription(Trajectory, "/planning/scenario_planning/original_trajectory", self._original_trajectory_callback, qos_profile)

        # Publisher - 使用与原始发布器相同的QoS设置
        self.trajectory_pub = self.create_publisher(Trajectory, "/planning/scenario_planning/trajectory", qos_profile)

        # State variables
        self.current_odometry = None
        self.original_trajectory_msg = None  # 存储原始轨迹消息
        self.static_path_pts = None  # 存储静态路径点
        self.is_model_loaded = True  # Model is loaded in __init__
        
        self.dt = self.time_step  # 添加时间步长变量

        # Create a timer that attempts to plan and publish
        self.create_timer(0.1, self.planner_callback)  # 10Hz planning
        
        self.get_logger().info("🚀 SAC Integration Phase Complete - Ready for detailed monitoring!")
        self.get_logger().info("NN Planner Node initialized successfully")

    def _initialize_sac_components(self):
        """初始化SAC相关组件（V2 架构）"""
        self.get_logger().info("🚀 Initializing SAC components (V2 Architecture)...")
        
        action_dim = 1
        feature_dim = 256 # LSTM hidden size
        
        actor = SACActorNetwork(feature_dim=feature_dim, action_dim=action_dim).to(self.device)
        critic = SACCriticNetwork(feature_dim=feature_dim, action_dim=action_dim).to(self.device)
        
        # 加载预训练LSTM权重 - 使用已经声明的参数
        self._load_pretrained_lstm_weights(actor, self.model_path)

        components = {
            'state_manager': SACStateManager(),
            'action_manager': SACActionManager(), 
            'reward_calculator': SACRewardCalculator(),
            'actor': actor,
            'critic': critic,
            'target_critic': SACCriticNetwork(feature_dim=feature_dim, action_dim=action_dim).to(self.device),
        }
        
        # 初始化目标网络
        components['target_critic'].load_state_dict(components['critic'].state_dict())

        # 设置优化器
        self.actor_optimizer = torch.optim.Adam(components['actor'].parameters(), lr=3e-4)
        self.critic_optimizer = torch.optim.Adam(components['critic'].parameters(), lr=3e-4)

        # 初始化日志系统
        self.sac_logger = SACLogger(self.get_logger())
        
        # 验证组件
        self._validate_sac_components(components)
        
        return components

    def _load_pretrained_lstm_weights(self, actor_network, model_path):
        """将预训练的LSTM权重加载到Actor网络的特征提取器中。"""
        self.get_logger().info(f"--- Loading pretrained LSTM weights from: {model_path} ---")
        try:
            pretrained_dict = torch.load(model_path, map_location=self.device)
            feature_extractor_dict = actor_network.feature_extractor.state_dict()
            
            # 创建一个新的字典，只包含LSTM层的权重
            # 旧模型键是 "lstm.weight_ih_l0" 等, 新模型是 "lstm.weight_ih_l0"
            # 命名完全匹配，可以直接加载
            lstm_weights = {k: v for k, v in pretrained_dict.items() if k in feature_extractor_dict and 'lstm' in k}

            if not lstm_weights:
                self.get_logger().error("No matching LSTM layers found in the pretrained model!")
                return

            feature_extractor_dict.update(lstm_weights)
            actor_network.feature_extractor.load_state_dict(feature_extractor_dict)
            self.get_logger().info(f"--- Successfully loaded {len(lstm_weights)} LSTM layer weights into the feature extractor. ---")

        except Exception as e:
            self.get_logger().error(f"Failed to load pretrained LSTM weights: {e}")


    def _validate_sac_components(self, components):
        """验证SAC组件的正确性 (V2 架构)"""
        self.get_logger().info("🔍 Validating SAC components (V2)...")
        
        try:
            # 测试状态维度 (序列)
            dummy_state_seq = torch.randn(1, 90, 13).to(self.device)
            dummy_action = torch.randn(1, 1).to(self.device)
            
            # 测试Actor
            mean, log_std = components['actor'](dummy_state_seq)
            assert mean.shape == (1, 1), f"Actor output shape error: {mean.shape}"
            self.get_logger().info("✅ Actor validation passed")
            
            # 测试Critic (需要先通过actor获取feature)
            features = components['actor'].feature_extractor(dummy_state_seq)
            q1, q2 = components['critic'](features, dummy_action)
            assert q1.shape == (1, 1), f"Critic output shape error: {q1.shape}"
            self.get_logger().info("✅ Critic validation passed")
            
            # 测试奖励计算
            dummy_state_info = {
                'velocity': 10.0,
                'distance_from_centerline': 0.2,
                'curvature': 0.05
            }
            terminated = components['reward_calculator'].is_terminated(dummy_state_info)
            reward, components_reward = components['reward_calculator'].calculate_reward(
                dummy_state_info, 10.0, terminated
            )
            assert isinstance(reward, (int, float)), "Reward calculation failed"
            self.get_logger().info("✅ Reward calculation validation passed")
            
            self.get_logger().info("🎉 All SAC components validated successfully!")
            
        except Exception as e:
            self.sac_logger.log_error("SAC component validation failed", e)
            raise

    def planner_callback(self):
        """
        主规划回调函数：LSTM推理 + 正确的时空域映射 + SAC计算
        
        流程：
        1. LSTM推理：输出50个时间步的速度预测
        2. 时空域映射：将时间预测转换为稀疏的空间路径点速度
        3. 混合轨迹创建：在完整CSV路径上应用稀疏的LSTM速度控制
        4. SAC计算：基于当前状态进行强化学习推理（目前为eval模式）
        """
        self.planning_start_time = time.time()
        
        # 检查所有必需的数据是否就绪
        if (self.current_odometry is None or 
            self.original_trajectory_msg is None or 
            self.static_path_pts is None):
            return  # 等待所有必需的数据

        # 检查原始轨迹是否为空
        if len(self.original_trajectory_msg.points) == 0:
            return

        try:
            # V3 方案: 决策与执行解耦
            # 1. 无论是否为决策周期，都持续应用上一次的动作决策
            direct_trajectory = self.create_direct_trajectory(self.last_action)
            self.trajectory_pub.publish(direct_trajectory)

            # 2. 判断当前是否为决策周期
            is_decision_step = (self.step_counter % self.decision_interval == 0)
            
            if is_decision_step:
                # === 这是决策周期，进行思考和学习 ===

                # a. 获取当前状态 (s_t)
                current_state_seq = self._extract_sac_state()
                if current_state_seq is None:
                    self.step_counter += 1
                    return # 等待有效状态

                # b. 基于上一个决策周期的数据进行学习
                if self.last_decision_state_seq is not None:
                    # i. 获取新状态 (s_t+1), 即当前状态
                    next_state_seq = current_state_seq

                    # ii. 计算奖励 (r_t) 和是否终止
                    state_info = self._extract_state_info()
                    # 传入的是上个周期的动作 self.last_action
                    terminated = self.sac_components['reward_calculator'].is_terminated(state_info)
                    reward, reward_components = self.sac_components['reward_calculator'].calculate_reward(
                        state_info, self.last_action, terminated
                    )
                    
                    # iii. 存储经验 (s_t, a_t, r_t, s_t+1, done_t)
                    self.replay_buffer.store(
                        self.last_decision_state_seq, 
                        np.array([self.last_action]), 
                        reward, 
                        next_state_seq, 
                        float(terminated)
                    )

                    # iv. 如果Replay Buffer足够大，则进行训练
                    if len(self.replay_buffer) > 256: # BATCH_SIZE
                        self.sac_update(batch_size=256)
                    
                    if self.sac_debug_logging:
                        self.get_logger().info(f"Decision Cycle {self.step_counter // self.decision_interval}: Reward={reward:.2f}, Terminated={terminated}")
                        self.get_logger().info(f"  Reward Components: {reward_components}")


                # c. 做出新决策 (a_t) 并保存
                with torch.no_grad():
                    state_tensor = torch.FloatTensor(current_state_seq).unsqueeze(0).to(self.device)
                    action_t, _, _ = self.sac_components['actor'].sample(state_tensor)
                    self.last_action = action_t.item()

                # d. 更新last_action用于奖励计算器中的平滑性计算
                self.sac_components['reward_calculator'].last_action = self.last_action
                
                # e. 保存当前状态和动作用于下一步计算
                self.last_decision_state_seq = current_state_seq

                if self.sac_debug_logging:
                    current_velocity = self.current_odometry.twist.twist.linear.x
                    self.get_logger().info(f"New Decision - Current Vel: {current_velocity:.2f}, New Target Vel: {self.last_action:.2f}")

            # 3. 步数计数器递增
            self.step_counter += 1

        except Exception as e:
            self.get_logger().error(f"Planning failed: {e}")
            import traceback
            self.get_logger().error(f"Full traceback: {traceback.format_exc()}")
            # 发布原始轨迹作为后备
            self.trajectory_pub.publish(self.original_trajectory_msg)

    def _find_closest_path_idx(self, state, path_pts, search_start_idx=0):
        """
        V4 方案: 前进式路径点搜索。
        从指定的 search_start_idx 开始，在前方的一个窗口内搜索最近点。
        """
        pos = state.pose.pose.position
        current_pos = np.array([pos.x, pos.y])
        
        num_path_pts = len(path_pts)
        search_window = 100 # 向前搜索100个点
        
        # 确定搜索范围，并处理循环
        end_idx = search_start_idx + search_window
        indices_to_search = [i % num_path_pts for i in range(search_start_idx, end_idx)]
        
        # 提取要搜索的路径点
        points_to_search = path_pts[indices_to_search]
        
        # 计算距离并找到窗口内的最近点
        distances = np.linalg.norm(points_to_search - current_pos, axis=1)
        relative_closest_idx = np.argmin(distances)
        
        # 将相对索引转换回绝对索引
        absolute_closest_idx = indices_to_search[relative_closest_idx]
        
        return absolute_closest_idx

    def create_direct_trajectory(self, target_velocity):
        """
        V2 方案: 直接修改轨迹，将SAC的单一速度决策应用到前方路径点。
        
        修复: 当车辆接近轨迹末尾时，将控制应用到轨迹开始部分，形成循环。
        """
        output_trajectory = Trajectory()
        output_trajectory.header.stamp = self.get_clock().now().to_msg()
        output_trajectory.header.frame_id = "map"

        if not self.original_trajectory_msg or len(self.original_trajectory_msg.points) == 0:
            if self.sac_debug_logging:
                self.get_logger().error("No original trajectory available!")
            return output_trajectory

        # V4 方案: 使用前进式搜索
        current_idx = self._find_closest_path_idx(self.current_odometry, self.static_path_pts, self.last_closest_idx)
        self.last_closest_idx = current_idx # 更新最后找到的索引

        current_velocity = self.current_odometry.twist.twist.linear.x
        total_points = len(self.original_trajectory_msg.points)
        
        # 定义速度应用范围 (未来20个点)
        apply_horizon = 20
        
        # 修复：如果车辆接近轨迹末尾，将控制应用到轨迹开始部分
        if current_idx > total_points - apply_horizon:
            # 车辆接近末尾，将速度控制应用到轨迹开始的前20个点
            apply_start_idx = 0
            apply_end_idx = apply_horizon
            if self.sac_debug_logging:
                self.get_logger().info(f"Vehicle near end (idx {current_idx}), applying control to trajectory start [0:{apply_horizon}]")
        else:
            # 正常情况，应用到当前位置前方
            apply_start_idx = current_idx
            apply_end_idx = current_idx + apply_horizon

        # V5 最终方案: 废除线性速度剖面，应用恒定的目标巡航速度
        # 物理模拟器和底层控制器将负责平滑加速过程

        applied_count = 0
        
        for i, original_point in enumerate(self.original_trajectory_msg.points):
            traj_point = type(original_point)()
            
            # 复制位置和姿态信息
            traj_point.pose = original_point.pose
            
            # 设置速度相关字段 - 匹配simple_trajectory_generator的格式
            if apply_start_idx <= i < apply_end_idx:
                # 直接将应用范围内的所有点的速度设置为目标巡航速度
                traj_point.longitudinal_velocity_mps = float(target_velocity)
                applied_count += 1
            else:
                traj_point.longitudinal_velocity_mps = original_point.longitudinal_velocity_mps
            
            # 按照simple_trajectory_generator的格式设置其他字段为0
            traj_point.lateral_velocity_mps = 0.0
            traj_point.acceleration_mps2 = 0.0
            traj_point.heading_rate_rps = 0.0
            # 不设置 front_wheel_angle_rad 和 rear_wheel_angle_rad
            
            output_trajectory.points.append(traj_point)
            
        # 简化的调试日志
        if self.sac_debug_logging:
            self.get_logger().info(f"Applied SAC velocity {target_velocity:.2f} m/s to {applied_count} trajectory points")

        return output_trajectory

    def sac_update(self, batch_size, gamma=0.99, tau=0.005, alpha=0.2):
        """
        执行一次SAC训练更新。
        """
        # 1. 从回放池采样
        states, actions, rewards, next_states, dones = self.replay_buffer.sample(batch_size)
        states = states.to(self.device)
        actions = actions.to(self.device)
        rewards = rewards.to(self.device)
        next_states = next_states.to(self.device)
        dones = dones.to(self.device)

        # 2. 计算 Critic 损失
        with torch.no_grad():
            next_actions, next_log_prob, _ = self.sac_components['actor'].sample(next_states)
            next_features = self.sac_components['actor'].feature_extractor(next_states)
            
            target_q1, target_q2 = self.sac_components['target_critic'](next_features, next_actions)
            target_q = torch.min(target_q1, target_q2) - alpha * next_log_prob
            q_target = rewards + (1.0 - dones) * gamma * target_q

        current_features = self.sac_components['actor'].feature_extractor(states)
        current_q1, current_q2 = self.sac_components['critic'](current_features, actions)
        
        critic_loss = F.mse_loss(current_q1, q_target) + F.mse_loss(current_q2, q_target)
        
        # Critic 反向传播和更新
        self.critic_optimizer.zero_grad()
        critic_loss.backward()
        self.critic_optimizer.step()

        # 3. 计算 Actor 损失 (延迟更新)
        # 重新计算特征，避免重用已经参与反向传播的张量
        actor_features = self.sac_components['actor'].feature_extractor(states)
        new_actions, log_prob, _ = self.sac_components['actor'].sample(states)
        
        # 冻结Critic网络，避免在Actor更新时计算其梯度
        for p in self.sac_components['critic'].parameters():
            p.requires_grad = False

        q1_new, q2_new = self.sac_components['critic'](actor_features, new_actions)
        q_new = torch.min(q1_new, q2_new)
        
        actor_loss = (alpha * log_prob - q_new).mean()
        
        # Actor 反向传播和更新
        self.actor_optimizer.zero_grad()
        actor_loss.backward()
        self.actor_optimizer.step()

        # 解冻Critic网络
        for p in self.sac_components['critic'].parameters():
            p.requires_grad = True

        # 4. 软更新 Target Critic 网络
        with torch.no_grad():
            for target_param, param in zip(self.sac_components['target_critic'].parameters(), self.sac_components['critic'].parameters()):
                target_param.data.copy_(target_param.data * (1.0 - tau) + param.data * tau)

        # (可选) 日志记录损失 - 简化版本
        if self.sac_debug_logging:
            self.get_logger().info(f"SAC Update - Actor Loss: {actor_loss.item():.6f}, Critic Loss: {critic_loss.item():.6f}")

    # ======================================================================================
    # Feature Engineering (Copied from nn_planner_dev/post_process.py)
    # ======================================================================================
    
    def _compute_features_now(self):
        """计算当前状态的13维特征向量"""
        state_pose = self.current_odometry.pose.pose
        state_twist = self.current_odometry.twist.twist
        
        # Ego state
        current_velocity_x = state_twist.linear.x
        current_angular_velocity_z = state_twist.angular.z
        
        # Path-relative features
        closest_idx = self._find_closest_path_idx(self.current_odometry, self.static_path_pts, self.last_closest_idx)
        closest_pt = self.static_path_pts[closest_idx]
        
        distance = np.linalg.norm(np.array([state_pose.position.x, state_pose.position.y]) - closest_pt)
        path_vec = self.static_path_pts[min(closest_idx + 1, len(self.static_path_pts)-1)] - self.static_path_pts[max(closest_idx - 1, 0)]
        ego_vec = np.array([state_pose.position.x, state_pose.position.y]) - closest_pt
        cross_prod_z = np.cross(path_vec, ego_vec)
        distance_from_centerline = np.copysign(distance, cross_prod_z)
        
        quat = state_pose.orientation
        ego_yaw = R.from_quat([quat.x, quat.y, quat.z, quat.w]).as_euler('xyz', degrees=False)[2]
        path_yaw = np.arctan2(path_vec[1], path_vec[0])
        heading_error = (ego_yaw - path_yaw + np.pi) % (2 * np.pi) - np.pi
        
        # Curvature fingerprint
        sample_distances = [-25, -15, -10, -5, 0, 5, 10, 15, 25]
        curvature_features = []
        for dist in sample_distances:
            sample_idx = self._get_path_point_at_distance(self.static_path_pts, closest_idx, dist)
            p2 = self.static_path_pts[sample_idx]
            p1 = self.static_path_pts[max(0, sample_idx - 5)]
            p3 = self.static_path_pts[min(len(self.static_path_pts) - 1, sample_idx + 5)]
            curvature = self._calculate_curvature(p1, p2, p3) if not (np.array_equal(p1, p2) or np.array_equal(p2, p3)) else 0.0
            curvature_features.append(curvature)
            
        return np.concatenate([[current_velocity_x, current_angular_velocity_z, distance_from_centerline, heading_error], curvature_features])

    def _get_path_point_at_distance(self, path_pts, start_idx, distance):
        if distance == 0: return start_idx
        current_dist = 0.0
        if distance > 0:
            for i in range(start_idx, len(path_pts) - 1):
                current_dist += np.linalg.norm(path_pts[i+1] - path_pts[i])
                if current_dist >= distance: return i + 1
            return len(path_pts) - 1
        else:
            for i in range(start_idx, 0, -1):
                current_dist += np.linalg.norm(path_pts[i-1] - path_pts[i])
                if current_dist >= abs(distance): return i - 1
            return 0

    def _calculate_curvature(self, p1, p2, p3):
        a, b, c = np.linalg.norm(p2 - p3), np.linalg.norm(p1 - p3), np.linalg.norm(p1 - p2)
        if a * b * c == 0: return 0.0
        s = (a + b + c) / 2
        area_sq = s * (s - a) * (s - b) * (s - c)
        if area_sq <= 0: return 0.0
        area = np.sqrt(area_sq)
        curvature = (4 * area) / (a * b * c)
        cross_product_z = (p2[0] - p1[0]) * (p3[1] - p2[1]) - (p2[1] - p1[1]) * (p3[0] - p2[0])
        return np.copysign(curvature, cross_product_z)

    def _kinematic_state_callback(self, msg: Odometry):
        """
        处理运动学状态回调
        """
        self.current_odometry = msg

    def _original_trajectory_callback(self, msg: Trajectory):
        """
        处理原始轨迹回调，提取静态路径点
        """
        self.original_trajectory_msg = msg
        
        # 从轨迹中提取静态路径点 (x, y坐标)
        if len(msg.points) > 0:
            self.static_path_pts = np.array([
                [point.pose.position.x, point.pose.position.y] 
                for point in msg.points
            ])
            
            # 只在静态路径首次加载时记录日志
            if not hasattr(self, '_path_loaded'):
                self.get_logger().info(f"Static path loaded with {len(self.static_path_pts)} points")
                self._path_loaded = True

    def _extract_sac_state(self):
        """提取SAC状态特征 (V2)"""
        try:
            # 获取13维特征向量
            features = self._compute_features_now()
            if features is None:
                return None
            
            # 使用状态管理器构建完整的状态序列
            state_sequence = self.sac_components['state_manager'].get_state(features)
            return state_sequence
            
        except Exception as e:
            if self.sac_debug_logging:
                self.sac_logger.log_error(f"State extraction failed", e)
            return None

    def _extract_state_info(self):
        """提取状态信息用于奖励计算，复用_compute_features_now的计算结果"""
        try:
            features = self._compute_features_now()
            if features is None:
                return {}
            
            # 提取当前位置的曲率（来自特征向量的中心点曲率）
            curvature = features[8]  # sample_distances中索引4对应距离0，即当前位置
            
            return {
                'velocity': features[0],
                'angular_velocity': features[1], 
                'distance_from_centerline': features[2],
                'heading_error': features[3],
                'curvature': curvature,
            }
            
        except Exception as e:
            if self.sac_debug_logging:
                self.sac_logger.log_error(f"State info extraction failed", e)
            return {}

    def _detect_anomalies(self, step_data, loss_data):
        """检测异常值并记录警告"""
        # Q值异常检测
        q1, q2 = step_data['q1_value'], step_data['q2_value']
        if abs(q1) > 1000 or abs(q2) > 1000:
            self.sac_logger.log_warning(f"Q values are very large: Q1={q1:.2f}, Q2={q2:.2f}")
        
        # 动作异常检测
        action = step_data['final_action']
        if action < 0 or action > 15: # Updated action range
            self.sac_logger.log_warning(f"Action out of bounds: {action:.4f}")
        
        # 损失异常检测
        if loss_data:
            if loss_data['actor_loss'] > 100:
                self.sac_logger.log_warning(f"Actor loss very high: {loss_data['actor_loss']:.6f}")
            if loss_data['critic_loss'] > 100:
                self.sac_logger.log_warning(f"Critic loss very high: {loss_data['critic_loss']:.6f}")

    def _get_memory_usage(self):
        """获取内存使用情况"""
        try:
            if torch.cuda.is_available():
                return f"{torch.cuda.memory_allocated()/1024**2:.1f}MB"
            else:
                return "CPU"
        except:
            return "N/A"


def main(args=None):
    rclpy.init(args=args)
    node = NNPlannerNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        node.get_logger().info("Shutting down NN Planner Node...")
    finally:
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main() 